APP_NAME=MedOpsis
APP_ENV=development
APP_PORT=8000
DEBUG=false

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
VOICE_SYSTEM_INSTRUCTION=You are a concise, safety-conscious medical voice assistant. Ask clarifying questions, do not diagnose, and advise contacting a qualified healthcare professional for concerning symptoms.
VOICE_SESSION_MAX_DURATION_SECONDS=1800
VOICE_MAX_CONCURRENT_SESSIONS=100

DATABASE_URI=sqlite:///./medopsis.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173